{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.32.6/resources/schema.json",
    "tmpDir": "var/infection",
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "src/**/Tests"
        ]
    },
    "mutators": {
        "@default": true
    },
    "phpUnit": {
        "customPath": "bin/phpunit"
    },
    "staticAnalysisTool": "mago"
}
