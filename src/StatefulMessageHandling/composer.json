{
    "name": "ultra/stateful-message-handling",
    "description": "Ultra Framework - Stateful Message Handling",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Jean de La Bédoyère",
            "email": "1191198+jlabedo@users.noreply.github.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "psr/container": "^2.0",
        "ultra/container": "*",
        "ultra/mapper": "*",
        "ultra/message-handling": "*",
        "ultra/state-store": "*"
    },
    "suggest": {
        "symfony/dependency-injection": "Required to use Ultra\\StatefulMessageHandling\\StatefulMessageHandlingExtension.",
        "ultra/event-sourced-state": "Required for event-sourced decision handlers.",
        "ultra/event-sourced-state-compiler": "Compiles event-sourced entity loaders for the Symfony bundle.",
        "ultra/event-store": "Required for event-sourced decision handlers."
    },
    "autoload": {
        "psr-4": {
            "Ultra\\StatefulMessageHandling\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    }
}
