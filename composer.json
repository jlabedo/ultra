{
    "name": "ultra/ultra",
    "description": "Ultra Framework - A modern PHP framework",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "laminas/laminas-code": "^4.17",
        "symfony/type-info": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "monorepo-php/monorepo": "^12.4",
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Ultra\\": "src"
        },
        "exclude-from-classmap": [
            "**/Tests/",
            "**/bin/"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "cs-fix": "php-cs-fixer fix"
    }
}
