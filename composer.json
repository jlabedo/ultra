{
    "name": "ultra/ultra",
    "description": "Ultra Framework - A modern PHP framework",
    "license": "proprietary",
    "type": "project",
    "authors": [
        {
            "name": "Jean de La Bédoyère",
            "email": "1191198+jlabedo@users.noreply.github.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "phpstan/phpdoc-parser": "^2.0",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "symfony/dependency-injection": "7.*|8.*",
        "symfony/type-info": "7.*|8.*"
    },
    "require-dev": {
        "doctrine/dbal": "^4.0",
        "opis/closure": "^4.0",
        "symfony/config": "7.*|8.*",
        "symfony/console": "7.*|8.*",
        "symfony/process": "7.*|8.*"
    },
    "replace": {
        "ultra/code-generation": "self.version",
        "ultra/container": "self.version",
        "ultra/event-sourced-state": "self.version",
        "ultra/event-sourced-state-compiler": "self.version",
        "ultra/event-store": "self.version",
        "ultra/event-store-postgres": "self.version",
        "ultra/events": "self.version",
        "ultra/mapped-table": "self.version",
        "ultra/mapper": "self.version",
        "ultra/mapper-bundle": "self.version",
        "ultra/mapper-compiler": "self.version",
        "ultra/message-handling": "self.version",
        "ultra/message-handling-compiler": "self.version",
        "ultra/message-handling-postgres-queue": "self.version",
        "ultra/projection": "self.version",
        "ultra/projection-postgres": "self.version",
        "ultra/schema": "self.version",
        "ultra/state-store": "self.version",
        "ultra/state-store-bundle": "self.version",
        "ultra/stateful-message-handling": "self.version",
        "ultra/symfony-bundle": "self.version",
        "ultra/time": "self.version",
        "ultra/unit-of-work": "self.version"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ultra\\": "src"
        },
        "exclude-from-classmap": [
            "**/Tests/",
            "**/bin/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ultra\\Mediator_Example\\OrderProcessing\\": "tests/mediator_example/src/",
            "Ultra\\Mapper_Example\\": "tests/mapper_example/src/",
            "IamExample\\": "examples/iam/src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "bench:event-store-postgres": "php benchmark_event_store_postgres.php",
        "install-tools": "php tools/bootstrap/install.php",
        "post-install-cmd": "@install-tools",
        "post-update-cmd": "@install-tools",
        "test": "ULTRA_TEST_POSTGRES_DSN='pgsql://ultra:ultra@127.0.0.1:55432/ultra_test' bin/phpunit",
        "test:coverage": "ULTRA_TEST_POSTGRES_DSN='pgsql://ultra:ultra@127.0.0.1:55432/ultra_test' bin/phpunit --coverage",
        "cs-fix": "bin/php-cs-fixer fix"
    }
}
