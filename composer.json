{
    "name": "ultra/ultra",
    "description": "Ultra Framework - A modern PHP framework",
    "license": "proprietary",
    "type": "project",
    "authors": [
        {
            "name": "Jean de La Bédoyère",
            "email": "1191198+jlabedo@users.noreply.github.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "phpstan/phpdoc-parser": "^2.0",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "symfony/dependency-injection": "7.*|8.*",
        "symfony/type-info": "7.*|8.*"
    },
    "require-dev": {
        "doctrine/dbal": "^4.0",
        "opis/closure": "^4.0",
        "symfony/config": "7.*|8.*",
        "symfony/console": "7.*|8.*",
        "symfony/process": "7.*|8.*"
    },
    "replace": {
        "ultra/code-generation": "self.version",
        "ultra/container": "self.version",
        "ultra/event-sourced-state": "self.version",
        "ultra/event-sourced-state-compiler": "self.version",
        "ultra/event-store": "self.version",
        "ultra/event-store-postgres": "self.version",
        "ultra/events": "self.version",
        "ultra/mapped-table": "self.version",
        "ultra/mapper": "self.version",
        "ultra/mapper-bundle": "self.version",
        "ultra/mapper-compiler": "self.version",
        "ultra/message-handling": "self.version",
        "ultra/message-handling-compiler": "self.version",
        "ultra/message-handling-postgres-queue": "self.version",
        "ultra/projection": "self.version",
        "ultra/projection-postgres": "self.version",
        "ultra/schema": "self.version",
        "ultra/state-store": "self.version",
        "ultra/state-store-bundle": "self.version",
        "ultra/stateful-message-handling": "self.version",
        "ultra/symfony-bundle": "self.version",
        "ultra/testing-postgres": "self.version",
        "ultra/time": "self.version",
        "ultra/unit-of-work": "self.version"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ultra\\CodeGeneration\\": "src/CodeGeneration/Runtime/",
            "Ultra\\Container\\": "src/Symfony/Container/",
            "Ultra\\Coordination\\": "src/Coordination/Runtime/",
            "Ultra\\Coordination_Postgres\\": "src/Coordination/Postgres/",
            "Ultra\\EventSourcedState\\": "src/EventSourcing/State/",
            "Ultra\\EventSourcedState_Compiler\\": "src/EventSourcing/Compiler/",
            "Ultra\\EventStore\\": "src/EventSourcing/EventStore/",
            "Ultra\\EventStore_Postgres\\": "src/EventSourcing/Postgres/",
            "Ultra\\Events\\": "src/EventSourcing/Events/",
            "Ultra\\MappedTable\\": "src/StoredState/MappedTable/",
            "Ultra\\Mapper\\": "src/Mapper/Runtime/",
            "Ultra\\Mapper_Bundle\\": "src/Mapper/Symfony/",
            "Ultra\\Mapper_Compiler\\": "src/Mapper/Compiler/",
            "Ultra\\MessageHandling\\": "src/MessageHandling/Runtime/",
            "Ultra\\MessageHandling_Compiler\\": "src/MessageHandling/Compiler/",
            "Ultra\\MessageHandling_PostgresQueue\\": "src/MessageHandling/PostgresQueue/",
            "Ultra\\Projection\\": "src/Projection/Runtime/",
            "Ultra\\Projection_Postgres\\": "src/Projection/Postgres/",
            "Ultra\\Schema\\": "src/Schema/Runtime/",
            "Ultra\\StateStore\\": "src/StoredState/StateStore/",
            "Ultra\\StateStore_Bundle\\": "src/StoredState/Symfony/",
            "Ultra\\StatefulMessageHandling\\": "src/MessageHandling/Stateful/",
            "Ultra\\SymfonyBundle\\": "src/Symfony/Bundle/",
            "Ultra\\Testing\\": [
                "src/Testing/",
                "src/Testing/Postgres/"
            ],
            "Ultra\\Time\\": "src/Time/Runtime/",
            "Ultra\\UnitOfWork\\": "src/UnitOfWork/Runtime/"
        },
        "exclude-from-classmap": [
            "**/Tests/",
            "**/bin/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ultra\\CodeGeneration\\Tests\\": "src/CodeGeneration/Tests/",
            "Ultra\\Container\\Tests\\": "src/Symfony/Tests/",
            "Ultra\\Coordination\\Tests\\": "src/Coordination/Tests/",
            "Ultra\\EventSourcedState\\Tests\\": "src/EventSourcing/Tests/State/",
            "Ultra\\EventStore\\Tests\\": "src/EventSourcing/Tests/",
            "Ultra\\MappedTable\\Tests\\": "src/StoredState/Tests/MappedTable/",
            "Ultra\\Mapper\\Tests\\": "src/Mapper/Tests/",
            "Ultra\\MessageHandling\\Tests\\": "src/MessageHandling/Tests/",
            "Ultra\\MessageHandling_Compiler\\Tests\\": "src/MessageHandling/Tests/Compiler/",
            "Ultra\\Projection\\Tests\\": "src/Projection/Tests/",
            "Ultra\\Projection_Postgres\\Tests\\": "src/Projection/Tests/Postgres/",
            "Ultra\\Schema\\Tests\\": "src/Schema/Tests/",
            "Ultra\\StateStore\\Tests\\": "src/StoredState/Tests/",
            "Ultra\\StatefulMessageHandling\\Tests\\": "src/MessageHandling/Tests/Stateful/",
            "Ultra\\Testing\\Tests\\": "src/Testing/Tests/",
            "Ultra\\Time\\Tests\\": "src/Time/Tests/",
            "Ultra\\UnitOfWork\\Tests\\": "src/UnitOfWork/Tests/",
            "Ultra\\Mediator_Example\\OrderProcessing\\": "tests/mediator_example/src/",
            "Ultra\\Mapper_Example\\": "tests/mapper_example/src/",
            "IamExample\\": "examples/iam/src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "bench:event-store-postgres": "php benchmark_event_store_postgres.php",
        "install-tools": "php tools/bootstrap/install.php",
        "post-install-cmd": "@install-tools",
        "post-update-cmd": "@install-tools",
        "test": "bin/phpunit",
        "test:coverage": "bin/phpunit --coverage"
    }
}
