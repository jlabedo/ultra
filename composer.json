{
    "name": "ultra/ultra",
    "description": "Ultra Framework - A modern PHP framework",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "monorepo-php/monorepo": "^12.4",
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Ultra\\Aop\\": "packages/aop/src",
            "Ultra\\Serializer\\": "packages/serializer/src",
            "Ultra\\Orm\\": "packages/orm/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ultra\\Aop\\Tests\\": "packages/aop/tests",
            "Ultra\\Serializer\\Tests\\": "packages/serializer/tests",
            "Ultra\\Orm\\Tests\\": "packages/orm/tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "cs-fix": "php-cs-fixer fix"
    }
}
