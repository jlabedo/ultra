{
    "name": "ultra/ultra",
    "description": "Ultra Framework - A modern PHP framework",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Jean de La Bédoyère",
            "email": "1191198+jlabedo@users.noreply.github.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "laminas/laminas-code": "^4.5",
        "psr/container": "^2.0",
        "symfony/dependency-injection": "7.*|8.*",
        "symfony/type-info": "7.*|8.*"
    },
    "require-dev": {
        "doctrine/dbal": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "monorepo-php/monorepo": "^12.4",
        "pestphp/pest": "^4",
        "symfony/config": "7.*|8.*",
        "symfony/framework-bundle": "7.*|8.*",
        "symfony/http-kernel": "7.*|8.*",
        "symfony/process": "7.*|8.*"
    },
    "replace": {
        "ultra/aop": "self.version",
        "ultra/decision-engine": "self.version",
        "ultra/event-bus": "self.version",
        "ultra/event-bus-bundle": "self.version",
        "ultra/event-bus-compiler": "self.version",
        "ultra/event-store": "self.version",
        "ultra/event-store-postgres": "self.version",
        "ultra/mapper": "self.version",
        "ultra/mapper-compiler": "self.version",
        "ultra/mediator": "self.version",
        "ultra/mediator-bundle": "self.version",
        "ultra/mediator-compiler": "self.version"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ultra\\": "src"
        },
        "exclude-from-classmap": [
            "**/Tests/",
            "**/bin/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ultra\\Mediator_Example\\OrderProcessing\\": "tests/mediator_example/src/",
            "Ultra\\Mapper_Example\\": "tests/mapper_example/src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "bench:event-store-postgres": "php benchmark_event_store_postgres.php",
        "test": "pest",
        "test:event-store-concurrency": "pest --all --group event-store-concurrency",
        "test:coverage": "pest --coverage",
        "cs-fix": "php-cs-fixer fix"
    }
}
