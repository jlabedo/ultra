{
    "name": "ultra/symfony-event-sourcing-example",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../src/*/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-pdo_pgsql": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.2",
        "symfony/console": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/yaml": "^8.0",
        "ultra/coordination-postgres": "dev-main",
        "ultra/event-sourced-state": "dev-main",
        "ultra/event-sourced-state-compiler": "dev-main",
        "ultra/event-store": "dev-main",
        "ultra/event-store-postgres": "dev-main",
        "ultra/events": "dev-main",
        "ultra/mapped-table": "dev-main",
        "ultra/mapper": "dev-main",
        "ultra/mapper-bundle": "dev-main",
        "ultra/mapper-compiler": "dev-main",
        "ultra/message-handling": "dev-main",
        "ultra/message-handling-compiler": "dev-main",
        "ultra/projection": "dev-main",
        "ultra/projection-postgres": "dev-main",
        "ultra/stateful-message-handling": "dev-main",
        "ultra/symfony-bundle": "dev-main",
        "ultra/unit-of-work": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "description": "Symfony integration of Unit of Work, event sourcing and a Mapped Table projection"
}
