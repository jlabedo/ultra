{
    "name": "ultra/mapped-table-symfony-example",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../src/*/*",
            "options": {
                "symlink": true,
                "versions": {
                    "ultra/mapped-table": "dev-main",
                    "ultra/schema": "dev-main",
                    "ultra/unit-of-work": "dev-main"
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-pdo_pgsql": "*",
        "doctrine/dbal": "^4.0",
        "symfony/dependency-injection": "7.*|8.*",
        "ultra/mapped-table": "dev-main",
        "ultra/schema": "dev-main",
        "ultra/unit-of-work": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "MappedTableSymfonyExample\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
