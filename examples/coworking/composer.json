{
    "name": "ultra/coworking-example",
    "type": "project",
    "license": "proprietary",
    "description": "DX stress test: coworking room booking with event-sourced, state-store and classic Doctrine ORM implementations",
    "repositories": [
        {
            "type": "path",
            "url": "../../src/*/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "doctrine/dbal": "^4.3",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "php": ">=8.5",
        "symfony/console": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/framework-bundle": "8.0.*",
        "symfony/runtime": "8.0.*",
        "symfony/yaml": "8.0.*",
        "ultra/event-sourced-state": "dev-main",
        "ultra/event-sourced-state-compiler": "dev-main",
        "ultra/event-store": "dev-main",
        "ultra/event-store-postgres": "dev-main",
        "ultra/events": "dev-main",
        "ultra/mapped-table": "dev-main",
        "ultra/mapper": "dev-main",
        "ultra/mapper-bundle": "dev-main",
        "ultra/mapper-compiler": "dev-main",
        "ultra/message-handling": "dev-main",
        "ultra/message-handling-compiler": "dev-main",
        "ultra/state-store": "dev-main",
        "ultra/state-store-bundle": "dev-main",
        "ultra/stateful-message-handling": "dev-main",
        "ultra/symfony-bundle": "dev-main",
        "ultra/time": "dev-main",
        "ultra/unit-of-work": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "test": "phpunit"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*"
        }
    }
}