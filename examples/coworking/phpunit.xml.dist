<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" cacheDirectory=".phpunit.cache" colors="true">
    <testsuites>
        <testsuite name="Coworking Example">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <!-- Tests reproducing framework gaps described in FINDINGS.md; run them with the "finding" group. -->
    <groups>
        <exclude>
            <group>finding</group>
        </exclude>
    </groups>

    <php>
        <server name="APP_ENV" value="test"/>
        <server name="APP_DEBUG" value="1"/>
        <server name="SHELL_VERBOSITY" value="-1"/>
    </php>
</phpunit>
