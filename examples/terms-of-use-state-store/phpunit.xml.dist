<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" cacheDirectory=".phpunit.cache" colors="true">
    <testsuites>
        <testsuite name="Terms of Use State Store Example">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <php>
        <server name="APP_ENV" value="test"/>
        <server name="APP_DEBUG" value="1"/>
    </php>
</phpunit>
