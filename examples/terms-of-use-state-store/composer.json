{
    "name": "ultra/terms-of-use-state-store-example",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../src/*/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/console": "8.0.*",
        "symfony/framework-bundle": "8.0.*",
        "symfony/runtime": "8.0.*",
        "symfony/yaml": "8.0.*",
        "ultra/mapped-table": "dev-main",
        "ultra/mapper": "dev-main",
        "ultra/mapper-bundle": "dev-main",
        "ultra/mapper-compiler": "dev-main",
        "ultra/message-handling": "dev-main",
        "ultra/message-handling-compiler": "dev-main",
        "ultra/state-store": "dev-main",
        "ultra/state-store-bundle": "dev-main",
        "ultra/stateful-message-handling": "dev-main",
        "ultra/symfony-bundle": "dev-main",
        "ultra/unit-of-work": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*"
        }
    }
}
